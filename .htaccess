<IfModule mod_rewrite.c>
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

RewriteEngine On

# ------------------------------------------------------------------
# SECURITY: on hosts where the document root is this project root
# (not public/) - see DEPLOYMENT.md - this app's own source/config
# files sit inside the web-served tree. Block direct HTTP access to
# all of them before anything below gets a chance to serve them.
# Keep these rules even after the document root is corrected to
# public/ - defense in depth costs nothing.
# ------------------------------------------------------------------
RewriteRule ^(\.env(\..*)?|\.git(/.*)?|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|deploy\.sh|DEPLOYMENT\.md|README\.md)$ - [F,L,NC]
RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor|node_modules)(/.*)?$ - [F,L,NC]

RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ ^$1 [N]

RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
RewriteRule ^(.*)$ public/$1

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ server.php
</IfModule>